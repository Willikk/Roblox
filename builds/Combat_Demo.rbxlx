      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">Clips</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Clips
	Registers every weapon move as a PoseLibrary clip (R6 procedural skill), generated from
	the move timings so the animation's strike frame IS the hitbox window.
	Call Clips.registerAll() once on every client (the server only sets attributes).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Weapons = require(script.Parent.Weapons)
local PoseLibrary = require(ReplicatedStorage:WaitForChild("R6Procedural"):WaitForChild("PoseLibrary"))

local Clips = {}

local registered = false

local function toPose(spec: Weapons.PoseSpec): PoseLibrary.Pose
	return (spec :: any) :: PoseLibrary.Pose
end

function Clips.blockName(weapon: Weapons.Weapon): string
	return weapon.name .. "_Block"
end

function Clips.parryName(weapon: Weapons.Weapon): string
	return weapon.name .. "_Parry"
end

function Clips.registerAll()
	if registered then
		return
	end
	registered = true
	for _, name in Weapons.NAMES do
		local weapon = Weapons.get(name)
		if weapon == nil then
			continue
		end
		local moves = table.clone(weapon.chain)
		table.insert(moves, weapon.critical)
		for _, move in moves do
			local windup, active, recovery = Weapons.timing(weapon, move)
			PoseLibrary.register(
				move.name,
				PoseLibrary.attack({
					windup = toPose(move.poses.windup),
					strike = toPose(move.poses.strike),
					follow = if move.poses.follow then toPose(move.poses.follow) else nil,
				}, { windup = windup, active = active, recovery = recovery })
			)
		end
		PoseLibrary.register(Clips.blockName(weapon), PoseLibrary.hold(toPose(weapon.blockPose), 0.08))
		PoseLibrary.register(Clips.parryName(weapon), PoseLibrary.reaction(toPose(weapon.parryPose), 0.05, 0.32))
	end
end

return Clips
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Config
	Every combat timing in one place (seconds at weapon speed 1). Defaults follow the
	Deepwoken / Sekiro model: parry is the cornerstone (tight window, whiff punished),
	blocking drains posture, a full posture bar = guard break, feints bait parries,
	dodges grant i-frames and can cancel your own windup.
]]

local Config = {
	-- Defense
	parryWindow = 0.18, -- active parry frames after tapping F
	parryWhiffCooldown = 0.65, -- a missed parry cannot be retried immediately (anti-spam)
	parryPostureReward = 12, -- posture recovered by a successful parry
	blockFacingAngle = 100, -- degrees: attacks from behind ignore block/parry
	blockWalkSpeed = 0.55, -- WalkSpeed multiplier while blocking

	-- Posture
	postureMax = 100,
	postureRegenDelay = 1.5,
	postureRegenRate = 18, -- per second
	guardBreakStun = 1.4,

	-- Offense
	chainResetTime = 0.9, -- time after a swing before the M1 chain resets to 1
	chainBuffer = 0.3, -- inputs this early in the previous recovery are queued
	hitStun = 0.45,
	finisherStun = 0.85, -- last hit of a chain
	parriedStun = 0.6, -- attacker stun when parried
	attackWalkSpeed = 0.6,
	stunWalkSpeed = 0.25,
	feintCooldown = 2.2,
	finisherKnockback = 38, -- studs/s

	-- Dodge
	dodgeDuration = 0.38,
	dodgeIFrames = 0.26,
	dodgeCooldown = 1.8,
	dodgeSpeed = 46,

	-- Networking / anti-cheat
	maxRewind = 0.25, -- lag compensation cap (seconds)
	historyLength = 1.5, -- position history kept per character
	hitboxPadding = 1.2, -- body radius added to the hitbox (studs)
	maxInputsPerSecond = 20,
	baseWalkSpeed = 16,

	-- Visual theme: "Default" (glow VFX) or "Dark" (pixel-art, roblox-dark-pixel-style).
	-- Override live with workspace attribute CombatVFXTheme.
	vfxTheme = "Default",
}

export type Config = typeof(Config)

-- Effect names per outcome for each theme ("Hit" nil = weapon.hitEffect).
Config.themes = {
	Default = { Slash = "Slash", Parry = "Parry", Block = "Block", GuardBreak = "GuardBreak", Telegraph = "Telegraph" },
	Dark = {
		Slash = "DarkSlash",
		Parry = "DarkParry",
		Block = "DarkBlock",
		GuardBreak = "DarkGuardBreak",
		Telegraph = "DarkTelegraph",
		Hit = "DarkHit",
	},
} :: { [string]: { [string]: string } }

-- Resolves the effect for an outcome under the active theme.
function Config.effect(kind: string, fallback: string): string
	local themeName = workspace:GetAttribute("CombatVFXTheme")
	local theme = Config.themes[if type(themeName) == "string" then themeName else Config.vfxTheme]
		or Config.themes.Default
	return theme[kind] or fallback
end

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Hitbox</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Hitbox
	Lag-compensated melee hit detection (pure math, tested).

	The server records every fighter's root CFrame each Heartbeat (History). When a swing
	becomes active it rewinds the DEFENDERS to the time the attacker saw them
	(clamped to Config.maxRewind so exploiters cannot hit from the past), then tests them
	against an oriented box in front of the attacker (+ body padding).
]]

local Hitbox = {}

-- Oriented box test: `point` inside `size` box at `boxCFrame`, grown by `padding`.
function Hitbox.contains(boxCFrame: CFrame, size: Vector3, point: Vector3, padding: number): boolean
	local p = boxCFrame:PointToObjectSpace(point)
	local h = size / 2 + Vector3.new(padding, padding, padding)
	return math.abs(p.X) <= h.X and math.abs(p.Y) <= h.Y and math.abs(p.Z) <= h.Z
end

-- Box CFrame for a move: centered `forward` studs in front of the attacker root.
function Hitbox.boxFor(rootCFrame: CFrame, forward: number): CFrame
	return rootCFrame * CFrame.new(0, 0, -forward)
end

export type History = {
	times: { number },
	frames: { CFrame },
	head: number, -- index of the newest sample
	count: number,
	capacity: number,
}

function Hitbox.newHistory(capacity: number): History
	return {
		times = table.create(capacity, 0),
		frames = table.create(capacity, CFrame.new()),
		head = 0,
		count = 0,
		capacity = capacity,
	}
end

function Hitbox.push(h: History, time: number, cframe: CFrame)
	h.head = h.head % h.capacity + 1
	h.times[h.head] = time
	h.frames[h.head] = cframe
	h.count = math.min(h.count + 1, h.capacity)
end

-- CFrame at `time` (interpolated), clamped to the recorded range.
function Hitbox.sample(h: History, time: number): CFrame?
	if h.count == 0 then
		return nil
	end
	local newest = h.head
	if time >= h.times[newest] then
		return h.frames[newest]
	end
	local index = newest
	for _ = 1, h.count - 1 do
		local previous = (index - 2) % h.capacity + 1
		local t0, t1 = h.times[previous], h.times[index]
		if time >= t0 then
			local k = if t1 > t0 then (time - t0) / (t1 - t0) else 0
			return h.frames[previous]:Lerp(h.frames[index], k)
		end
		index = previous
	end
	return h.frames[index] -- older than the buffer: oldest sample
end

return Hitbox
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Rules</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Rules
	The combat rulebook as pure functions (no services): what may start when, and how a
	hit resolves against the defender's state. Unit-tested under Lune; the server calls
	exactly these functions, so tests cover real gameplay logic.

	States: Idle, Attacking, Blocking, Parrying, Dodging, Stunned, GuardBroken.
	Outcomes: Hit, Blocked, Parried, GuardBreak, Dodged.
]]

local Config = require(script.Parent.Config)

export type State = "Idle" | "Attacking" | "Blocking" | "Parrying" | "Dodging" | "Stunned" | "GuardBroken"
export type Outcome = "Hit" | "Blocked" | "Parried" | "GuardBreak" | "Dodged"
export type Action = "M1" | "Critical" | "Feint" | "Parry" | "Block" | "Dodge"

export type Fighter = {
	state: State,
	stateUntil: number, -- when a timed state (stun, dodge, attack) ends
	phase: "windup" | "active" | "recovery" | "none", -- attack phase
	recoveryStart: number,
	parryStart: number,
	lastParryWhiff: number,
	iframesUntil: number,
	dodgeReadyAt: number,
	feintReadyAt: number,
	posture: number,
	lastPostureHit: number,
	combo: number,
	lastAttackEnd: number,
	hyperArmor: boolean,
}

export type AttackInfo = {
	perilous: boolean?,
	postureDamage: number,
}

local Rules = {}

function Rules.newFighter(): Fighter
	return {
		state = "Idle",
		stateUntil = 0,
		phase = "none",
		recoveryStart = 0,
		parryStart = -math.huge,
		lastParryWhiff = -math.huge,
		iframesUntil = -math.huge,
		dodgeReadyAt = 0,
		feintReadyAt = 0,
		posture = 0,
		lastPostureHit = -math.huge,
		combo = 0,
		lastAttackEnd = -math.huge,
		hyperArmor = false,
	}
end

local function locked(f: Fighter, now: number): boolean
	return (f.state == "Stunned" or f.state == "GuardBroken" or f.state == "Dodging") and now < f.stateUntil
end

-- Whether `action` may start now. Chains are allowed from the end of the previous
-- recovery minus the input buffer.
function Rules.canStart(f: Fighter, action: Action, now: number, cfg: Config.Config): boolean
	if locked(f, now) then
		return false
	end
	local attacking = f.state == "Attacking" and now < f.stateUntil
	if action == "M1" or action == "Critical" then
		if attacking then
			return f.phase == "recovery" and now >= f.recoveryStart - cfg.chainBuffer
		end
		return true
	elseif action == "Feint" then
		return attacking and f.phase == "windup" and now >= f.feintReadyAt
	elseif action == "Parry" then
		return not attacking and now - f.lastParryWhiff >= cfg.parryWhiffCooldown
	elseif action == "Block" then
		return not attacking
	elseif action == "Dodge" then
		-- Roll cancel: a dodge may interrupt your own windup.
		return now >= f.dodgeReadyAt and (not attacking or f.phase == "windup")
	end
	return false
end

-- Next chain index (1-based) for a new M1.
function Rules.nextCombo(f: Fighter, now: number, chainLength: number, cfg: Config.Config): number
	if now - f.lastAttackEnd <= cfg.chainResetTime and f.combo < chainLength and f.combo > 0 then
		return f.combo + 1
	end
	if f.state == "Attacking" and f.combo > 0 and f.combo < chainLength then
		return f.combo + 1 -- buffered input during recovery
	end
	return 1
end

-- Is the attacker inside the defender's guard cone?
function Rules.facing(
	defenderLook: Vector3,
	defenderPosition: Vector3,
	attackerPosition: Vector3,
	angleDeg: number
): boolean
	local toAttacker = attackerPosition - defenderPosition
	local flat = Vector3.new(toAttacker.X, 0, toAttacker.Z)
	local look = Vector3.new(defenderLook.X, 0, defenderLook.Z)
	if flat.Magnitude < 1e-3 or look.Magnitude < 1e-3 then
		return true
	end
	return look.Unit:Dot(flat.Unit) >= math.cos(math.rad(angleDeg))
end

-- Posture after natural regeneration.
function Rules.regenPosture(f: Fighter, now: number, dt: number, cfg: Config.Config): number
	if now - f.lastPostureHit < cfg.postureRegenDelay then
		return f.posture
	end
	return math.max(0, f.posture - cfg.postureRegenRate * dt)
end

--[[
	Resolves an attack landing on a defender at `now`. Returns the outcome and the
	defender's new posture. Order matters and mirrors Deepwoken:
	  i-frames > perilous (only dodge) > parry window > block (posture) > hit.
]]
function Rules.resolve(
	attack: AttackInfo,
	defender: Fighter,
	isFacing: boolean,
	now: number,
	cfg: Config.Config
): (Outcome, number)
	if now < defender.iframesUntil then
		return "Dodged", defender.posture
	end
	if attack.perilous then
		return "Hit", defender.posture
	end
	local guarding = defender.state == "Parrying" or defender.state == "Blocking"
	if guarding and isFacing then
		if defender.state == "Parrying" and now - defender.parryStart <= cfg.parryWindow then
			return "Parried", math.max(0, defender.posture - cfg.parryPostureReward)
		end
		local posture = defender.posture + attack.postureDamage
		if posture >= cfg.postureMax then
			return "GuardBreak", 0
		end
		return "Blocked", posture
	end
	return "Hit", defender.posture
end

return Rules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Weapons</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Weapons
	Pure data: every move's timing, damage, posture damage, hitbox and procedural poses.
	The same table drives the server (hit windows), the animation (clips generated from the
	timings, see Clips.luau) and the VFX, so they can never drift apart.

	Pose angles (degrees, Part0 space) — see PoseLibrary conventions:
	  shoulders X+ = arm forward (90 horizontal, 170 overhead), right arm Z+ = outward,
	  left arm Z+ = inward; RootJoint X+ = lean back, Y+ = twist left.
	Weapon profiles follow Deepwoken classes: fists = light (fast, short, low damage),
	sword = medium (balanced).
]]

export type Rot = { number }
export type PoseSpec = { [string]: { rot: Vector3, pos: Vector3? } }

export type Move = {
	name: string, -- unique clip name, e.g. "Sword_M1_1"
	windup: number,
	active: number,
	recovery: number,
	damage: number,
	postureDamage: number,
	hitboxSize: Vector3, -- width, height, depth (depth = reach)
	hitboxForward: number, -- center distance in front of the root
	knockback: number?, -- studs/s applied to the victim on hit
	finisher: boolean?, -- last chain hit: longer stun + knockback
	perilous: boolean?, -- red flash: cannot be parried or blocked, only dodged
	hyperArmor: boolean?, -- not interrupted by hits during windup
	vfx: string, -- VFX effect played at the strike ("Slash" or "none")
	slashTilt: number?, -- degrees, slash plane roll (sword arcs)
	slashMirror: boolean?,
	poses: { windup: PoseSpec, strike: PoseSpec, follow: PoseSpec? },
}

export type Weapon = {
	name: string,
	speed: number, -- global timing multiplier (higher = faster)
	chain: { Move },
	critical: Move,
	blockPose: PoseSpec,
	parryPose: PoseSpec,
	hitEffect: string, -- VFX on a clean hit ("ImpactBurst" / "FistImpact")
	hasBlade: boolean,
	blade: { size: Vector3, color: Color3, material: Enum.Material }?, -- visual blade (default sword)
}

local function r(x: number, y: number, z: number, pos: Vector3?): { rot: Vector3, pos: Vector3? }
	return { rot = Vector3.new(x, y, z), pos = pos }
end

local Weapons = {}

local function m(move: Move): Move
	return move
end

Weapons.Fists = (
	{
		name = "Fists",
		speed = 1.18,
		hitEffect = "FistImpact",
		hasBlade = false,
		chain = {
			m({
				name = "Fists_M1_1", -- left jab
				windup = 0.23,
				active = 0.09,
				recovery = 0.2,
				damage = 6,
				postureDamage = 9,
				hitboxSize = Vector3.new(4, 5, 5),
				hitboxForward = 3,
				vfx = "none",
				poses = {
					windup = { LeftShoulder = r(65, 0, 6), RightShoulder = r(85, 0, -22), RootJoint = r(0, -12, 0) },
					strike = {
						LeftShoulder = r(96, 0, 10),
						RightShoulder = r(80, 0, -25),
						RootJoint = r(-6, 16, 0, Vector3.new(0, 0, -0.25)),
					},
				},
			}),
			m({
				name = "Fists_M1_2", -- right cross
				windup = 0.24,
				active = 0.09,
				recovery = 0.21,
				damage = 7,
				postureDamage = 10,
				hitboxSize = Vector3.new(4, 5, 5),
				hitboxForward = 3,
				vfx = "none",
				poses = {
					windup = { RightShoulder = r(65, 0, 8), LeftShoulder = r(88, 0, 18), RootJoint = r(0, 16, 0) },
					strike = {
						RightShoulder = r(96, 0, -12),
						LeftShoulder = r(60, 0, 10),
						RootJoint = r(-8, -30, 0, Vector3.new(0, 0, -0.35)),
					},
				},
			}),
			m({
				name = "Fists_M1_3", -- left hook
				windup = 0.23,
				active = 0.1,
				recovery = 0.22,
				damage = 7,
				postureDamage = 11,
				hitboxSize = Vector3.new(6, 5, 5),
				hitboxForward = 2.8,
				vfx = "none",
				poses = {
					windup = { LeftShoulder = r(70, 0, -55), RightShoulder = r(85, 0, -20), RootJoint = r(0, 22, 0) },
					strike = { LeftShoulder = r(92, 0, 42), RightShoulder = r(75, 0, -15), RootJoint = r(-6, -32, 0) },
				},
			}),
			m({
				name = "Fists_M1_4", -- right uppercut (finisher)
				windup = 0.27,
				active = 0.11,
				recovery = 0.3,
				damage = 9,
				postureDamage = 14,
				hitboxSize = Vector3.new(4, 6, 5),
				hitboxForward = 3,
				knockback = 30,
				finisher = true,
				vfx = "none",
				poses = {
					windup = {
						RightShoulder = r(15, 0, 12),
						RootJoint = r(-12, -10, 0, Vector3.new(0, -0.45, 0)),
						LeftHip = r(20, 0, 0),
						RightHip = r(-10, 0, 0),
					},
					strike = {
						RightShoulder = r(168, 0, -12),
						LeftShoulder = r(40, 0, 0),
						RootJoint = r(10, -18, 0, Vector3.new(0, 0.25, -0.2)),
						Neck = r(14, 0, 0),
					},
				},
			}),
		},
		critical = m({
			name = "Fists_Critical", -- charged haymaker
			windup = 0.55,
			active = 0.12,
			recovery = 0.4,
			damage = 16,
			postureDamage = 40,
			hitboxSize = Vector3.new(5, 6, 6),
			hitboxForward = 3.4,
			knockback = 45,
			finisher = true,
			hyperArmor = true,
			vfx = "none",
			poses = {
				windup = {
					RightShoulder = r(40, 0, 75),
					LeftShoulder = r(80, 0, 30),
					RootJoint = r(4, 42, 0, Vector3.new(0, -0.2, 0.3)),
				},
				strike = {
					RightShoulder = r(96, 0, -28),
					LeftShoulder = r(30, 0, -20),
					RootJoint = r(-12, -42, 0, Vector3.new(0, -0.25, -0.7)),
					LeftHip = r(30, 0, 0),
					RightHip = r(-25, 0, 0),
				},
			},
		}),
		blockPose = {
			RightShoulder = r(122, 0, -34),
			LeftShoulder = r(122, 0, 34),
			Neck = r(-12, 0, 0),
			RootJoint = r(-6, 0, 0),
		},
		parryPose = { LeftShoulder = r(135, 0, -45), RightShoulder = r(110, 0, -30), RootJoint = r(4, 14, 0) },
	} :: any
) :: Weapon

Weapons.Sword = (
	{
		name = "Sword",
		speed = 1,
		hitEffect = "ImpactBurst",
		hasBlade = true,
		chain = {
			m({
				name = "Sword_M1_1", -- diagonal right-to-left
				windup = 0.28,
				active = 0.12,
				recovery = 0.26,
				damage = 11,
				postureDamage = 15,
				hitboxSize = Vector3.new(9, 6, 8),
				hitboxForward = 4,
				vfx = "Slash",
				slashTilt = 35,
				poses = {
					windup = { RightShoulder = r(150, 0, 55), RootJoint = r(0, -26, 0), Neck = r(0, 10, 0) },
					strike = {
						RightShoulder = r(62, 0, -38),
						LeftShoulder = r(-15, 0, 0),
						RootJoint = r(-8, 30, 0, Vector3.new(0, 0, -0.3)),
					},
					follow = { RightShoulder = r(40, 0, -48), RootJoint = r(-6, 34, 0) },
				},
			}),
			m({
				name = "Sword_M1_2", -- horizontal backhand left-to-right
				windup = 0.27,
				active = 0.12,
				recovery = 0.26,
				damage = 11,
				postureDamage = 15,
				hitboxSize = Vector3.new(10, 5, 8),
				hitboxForward = 4,
				vfx = "Slash",
				slashTilt = -8,
				slashMirror = true,
				poses = {
					-- Horizontal swing: raise the arm forward (X 90), sweep it with Y (left -> right).
					windup = { RightShoulder = r(92, 34, 0), RootJoint = r(0, 36, 0) },
					strike = { RightShoulder = r(92, -8, 0), RootJoint = r(-6, -32, 0, Vector3.new(0, 0, -0.3)) },
					follow = { RightShoulder = r(86, -30, 0), RootJoint = r(-4, -36, 0) },
				},
			}),
			m({
				name = "Sword_M1_3", -- overhead
				windup = 0.3,
				active = 0.12,
				recovery = 0.28,
				damage = 12,
				postureDamage = 17,
				hitboxSize = Vector3.new(6, 7, 8.5),
				hitboxForward = 4.2,
				vfx = "Slash",
				slashTilt = 90,
				poses = {
					windup = {
						RightShoulder = r(178, 0, 8),
						LeftShoulder = r(165, 0, -8),
						RootJoint = r(10, 0, 0),
						Neck = r(8, 0, 0),
					},
					strike = {
						RightShoulder = r(55, 0, -4),
						LeftShoulder = r(48, 0, 4),
						RootJoint = r(-20, 0, 0, Vector3.new(0, -0.25, -0.4)),
						LeftHip = r(18, 0, 0),
						RightHip = r(-12, 0, 0),
					},
				},
			}),
			m({
				name = "Sword_M1_4", -- lunging thrust (finisher)
				windup = 0.32,
				active = 0.12,
				recovery = 0.34,
				damage = 13,
				postureDamage = 20,
				hitboxSize = Vector3.new(4, 5, 10),
				hitboxForward = 5,
				knockback = 34,
				finisher = true,
				vfx = "none",
				poses = {
					windup = { RightShoulder = r(62, 0, 25), RootJoint = r(0, -32, 0, Vector3.new(0, 0, 0.45)) },
					strike = {
						RightShoulder = r(92, 0, -4),
						LeftShoulder = r(-25, 0, -10),
						RootJoint = r(-12, 16, 0, Vector3.new(0, -0.3, -0.9)),
						LeftHip = r(34, 0, 0),
						RightHip = r(-24, 0, 0),
					},
				},
			}),
		},
		critical = m({
			name = "Sword_Critical", -- perilous cleave (red flash: dodge it!)
			windup = 0.7,
			active = 0.14,
			recovery = 0.45,
			damage = 24,
			postureDamage = 0,
			hitboxSize = Vector3.new(10, 7, 9),
			hitboxForward = 4.5,
			knockback = 40,
			finisher = true,
			perilous = true,
			hyperArmor = true,
			vfx = "Slash",
			slashTilt = 70,
			poses = {
				windup = {
					RightShoulder = r(182, 0, 30),
					LeftShoulder = r(150, 0, -20),
					RootJoint = r(16, -22, 0, Vector3.new(0, 0, 0.3)),
				},
				strike = {
					RightShoulder = r(32, 0, -32),
					LeftShoulder = r(20, 0, 10),
					RootJoint = r(-26, 26, 0, Vector3.new(0, -0.5, -0.7)),
					LeftHip = r(34, 0, 0),
					RightHip = r(-26, 0, 0),
				},
			},
		}),
		blockPose = { RightShoulder = r(82, 0, -48), LeftShoulder = r(70, 0, -8), RootJoint = r(-6, 8, 0) },
		parryPose = { RightShoulder = r(112, 0, -62), LeftShoulder = r(40, 0, 0), RootJoint = r(2, 18, 0) },
	} :: any
) :: Weapon

Weapons.Greatsword = (
	{
		-- Dragonslayer-style slab of iron: slow, enormous reach, crushing posture damage.
		name = "Greatsword",
		speed = 0.74,
		hitEffect = "ImpactBurst",
		hasBlade = true,
		blade = {
			size = Vector3.new(0.35, 1.25, 7.5),
			color = Color3.fromRGB(58, 56, 55),
			material = Enum.Material.CorrodedMetal,
		},
		chain = {
			m({
				name = "Greatsword_M1_1", -- wide horizontal cleave (two hands)
				windup = 0.34,
				active = 0.15,
				recovery = 0.3,
				damage = 19,
				postureDamage = 26,
				hitboxSize = Vector3.new(15, 7, 11),
				hitboxForward = 5.5,
				vfx = "Slash",
				slashTilt = 10,
				poses = {
					windup = {
						RightShoulder = r(92, 48, 0),
						LeftShoulder = r(92, 62, 0),
						RootJoint = r(4, 44, 0, Vector3.new(0, -0.3, 0.3)),
					},
					strike = {
						RightShoulder = r(90, -10, 0),
						LeftShoulder = r(90, 0, 0),
						RootJoint = r(-10, -40, 0, Vector3.new(0, -0.45, -0.5)),
						LeftHip = r(26, 0, 0),
						RightHip = r(-18, 0, 0),
					},
					follow = {
						RightShoulder = r(80, -22, 0),
						LeftShoulder = r(80, -12, 0),
						RootJoint = r(-8, -48, 0, Vector3.new(0, -0.4, -0.4)),
					},
				},
			}),
			m({
				name = "Greatsword_M1_2", -- rising diagonal
				windup = 0.33,
				active = 0.15,
				recovery = 0.3,
				damage = 19,
				postureDamage = 26,
				hitboxSize = Vector3.new(12, 9, 11),
				hitboxForward = 5.5,
				vfx = "Slash",
				slashTilt = -50,
				slashMirror = true,
				poses = {
					windup = {
						RightShoulder = r(20, 0, 30),
						LeftShoulder = r(30, 0, 40),
						RootJoint = r(-6, -30, 0, Vector3.new(0, -0.5, 0.2)),
					},
					strike = {
						RightShoulder = r(165, 0, -30),
						LeftShoulder = r(150, 0, -20),
						RootJoint = r(12, 30, 0, Vector3.new(0, 0.1, -0.4)),
						Neck = r(10, 0, 0),
					},
				},
			}),
			m({
				name = "Greatsword_M1_3", -- falling cleave, full body
				windup = 0.4,
				active = 0.16,
				recovery = 0.38,
				damage = 23,
				postureDamage = 32,
				hitboxSize = Vector3.new(8, 9, 12),
				hitboxForward = 6,
				knockback = 55,
				finisher = true,
				vfx = "Slash",
				slashTilt = 88,
				poses = {
					windup = {
						RightShoulder = r(182, 0, 6),
						LeftShoulder = r(178, 0, -6),
						RootJoint = r(18, 0, 0, Vector3.new(0, 0.1, 0.4)),
						Neck = r(12, 0, 0),
					},
					strike = {
						RightShoulder = r(40, 0, -4),
						LeftShoulder = r(34, 0, 4),
						RootJoint = r(-32, 0, 0, Vector3.new(0, -0.8, -0.9)),
						LeftHip = r(40, 0, 0),
						RightHip = r(-28, 0, 0),
						Neck = r(-8, 0, 0),
					},
				},
			}),
		},
		critical = m({
			name = "Greatsword_Critical", -- spinning perilous cleave
			windup = 0.85,
			active = 0.2,
			recovery = 0.55,
			damage = 34,
			postureDamage = 0,
			hitboxSize = Vector3.new(18, 8, 16),
			hitboxForward = 4,
			knockback = 60,
			finisher = true,
			perilous = true,
			hyperArmor = true,
			vfx = "Slash",
			slashTilt = 5,
			poses = {
				windup = {
					RightShoulder = r(96, 70, 0),
					LeftShoulder = r(96, 80, 0),
					RootJoint = r(8, 70, 0, Vector3.new(0, -0.5, 0.3)),
					Neck = r(0, -40, 0),
				},
				strike = {
					RightShoulder = r(92, -30, 0),
					LeftShoulder = r(92, -20, 0),
					RootJoint = r(-14, -80, 0, Vector3.new(0, -0.6, -0.4)),
					LeftHip = r(20, 0, 0),
					RightHip = r(-20, 0, 0),
				},
			},
		}),
		blockPose = {
			RightShoulder = r(70, 0, -30),
			LeftShoulder = r(80, 0, -10),
			RootJoint = r(-8, 22, 0, Vector3.new(0, -0.3, 0)),
		},
		parryPose = { RightShoulder = r(120, 0, -40), LeftShoulder = r(110, 0, -20), RootJoint = r(4, 26, 0) },
	} :: any
) :: Weapon

-- Scaled timings for a move with its weapon speed.
function Weapons.timing(weapon: Weapon, move: Move): (number, number, number)
	local s = weapon.speed
	return move.windup / s, move.active / s, move.recovery / s
end

Weapons.NAMES = { "Fists", "Sword", "Greatsword" }

function Weapons.get(name: string): Weapon?
	local w = (Weapons :: any)[name]
	return if type(w) == "table" and w.chain then w else nil
end

return Weapons
]]></string>
