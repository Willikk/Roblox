      <Item class="Folder" referent="40">
        <Properties>
          <string name="Name">VFXClient</string>
        </Properties>
        <Item class="LocalScript" referent="41">
          <Properties>
            <string name="Name">VFXBootstrap</string>
            <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts: boots the VFX client (remote listeners, pools, preloading).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local VFXClient = require(ReplicatedStorage:WaitForChild("VFX"):WaitForChild("Client"))

VFXClient.start()
]]></string>
