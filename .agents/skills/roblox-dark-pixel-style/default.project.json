{
  "name": "roblox-dark-pixel-style",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "DarkStyle": { "$path": "src/shared/DarkStyle" },
      "Combat": { "$path": "../roblox-deepwoken-combat/src/shared/Combat" },
      "VFX": { "$path": "../roblox-mesh-vfx/src/shared/VFX" },
      "R6Procedural": { "$path": "../roblox-r6-procedural-animation/src/shared/R6Procedural" }
    },
    "ServerScriptService": {
      "CombatServer": { "$path": "../roblox-deepwoken-combat/src/server" },
      "VFXServer": {
        "$className": "Folder",
        "VFXService": { "$path": "../roblox-mesh-vfx/src/server/VFXService.luau" }
      },
      "R6ProceduralServer": { "$path": "../roblox-r6-procedural-animation/src/server" },
      "CombatArena": { "$path": "../roblox-deepwoken-combat/src/demo/Arena.server.luau" },
      "DarkArena": { "$path": "src/demo/DarkArena.server.luau" }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "CombatClient": { "$path": "../roblox-deepwoken-combat/src/client" },
        "DarkStyleClient": { "$path": "src/client" }
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": { "Technology": "Future", "GlobalShadows": true, "ShadowSoftness": 0 }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": { "Gravity": 196.2 },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": { "Anchored": true, "Size": [8, 1, 8], "Position": [0, 0.5, 14], "Transparency": 1, "CanCollide": true }
      }
    }
  }
}
